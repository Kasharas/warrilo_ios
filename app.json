{
  "expo": {
    "name": "Warrilo",
    "slug": "warrilo-mobile",
    "version": "1.0.0",
    "scheme": "warrilo",
    "icon": "./assets/images/icon.png",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcdfa3c1-d304-45d5-a77f-feccb85ea850"
      }
    },
    "ios": {
      "bundleIdentifier": "com.x699tomas.warrilomobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Warrilo needs access to your camera to take photos of your devices and receipts.",
        "NSPhotoLibraryUsageDescription": "Warrilo needs access to your photo library to select device and receipt photos.",
        "NSPhotoLibraryAddUsageDescription": "Warrilo needs permission to save photos to your library when you download warranty documents.",
        "NSUserNotificationsUsageDescription": "Warrilo uses notifications to remind you when your warranties are about to expire.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "warrilo"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.x699tomas.warrilomobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "warrilo",
              "host": "auth-callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-apple-authentication",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      "expo-splash-screen",
      "expo-file-system",
      [
        "expo-secure-store"
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ]
  }
}